# Скопировать в .env (в git не попадает) и заполнить.
# Секреты и параметры попадают в контейнер через переменные окружения
# (двойное подчёркивание — разделитель секций: Database__ConnectionString -> Database:ConnectionString).

# --- Задание 1.4: публикация образа ---
# Имя образа с тегом версии: <ваш-логин>/securechat-server:<версия>.
# docker compose build присвоит этот тег, docker compose push отправит его в Docker Hub.
SERVER_IMAGE=securechat-server:1.0.0

# --- Задание 1.3: конфигурация приложения ---
# Порт/адрес биндинга сервера. При смене порта поправьте ports в docker-compose.yml.
SERVER_BASE_URL=http://*:9000
# Строка подключения к SQLite (URL БД). По умолчанию файл лежит в томе /data.
DATABASE_CONNECTION_STRING=Data Source=/data/server.db;Default Timeout=10;

# --- Секреты ---
# Секрет подписи JWT-сессий: минимум 32 символа.
# Пусто — встроенный секрет разработки (только для локальных экспериментов).
JWT_SECRET=

# SMTP для писем с кодами подтверждения.
# UseRealSmtp=false (или пустые учётные данные) — dev-режим: код печатается в лог сервера.
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
SMTP_USE_REAL_SMTP=false

# --- Cloudflare Tunnel (доступ из интернета) ---
# Токен туннеля: dash.cloudflare.com -> Zero Trust -> Networks -> Tunnels -> туннель ->
# "Install and run a connector" -> Docker (смотреть параметр --token).
# Публичный hostname (домен -> http://localhost:9000) настраивается там же, в разделе Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
