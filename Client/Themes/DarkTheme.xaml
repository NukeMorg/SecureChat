<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="ForegroundColor" Color="White"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#FF252525"/>
    <SolidColorBrush x:Key="ContactItemBackground" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="ChatAreaBackground" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="InputAreaBackground" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="OutgoingMessageColor" Color="#FF1E88E5"/>
    <SolidColorBrush x:Key="IncomingMessageColor" Color="#FF424242"/>
    <SolidColorBrush x:Key="StatusForeground" Color="#FF888888"/>
    <SolidColorBrush x:Key="TimestampForeground" Color="#FFCCCCCC"/>
    <!-- Новые цвета для текста сообщений -->
    <SolidColorBrush x:Key="MessageTextForeground" Color="White"/>
    <SolidColorBrush x:Key="FilePathForeground" Color="#FFB3E5FC"/>
</ResourceDictionary>