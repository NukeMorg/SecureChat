<Window x:Class="SecureChat.Client.Print.PrintOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Печать чата" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundColor}">
    <StackPanel Margin="18">
        <TextBlock Text="Печать текущего чата" FontSize="15" FontWeight="Bold"/>
        <CheckBox x:Name="IncludeFilesCheck" Content="Включить вложения (имена файлов)" Margin="0,12,0,0"/>
        <CheckBox x:Name="WatermarkCheck" Content="Водяной знак «Конфиденциально»" IsChecked="True" Margin="0,8,0,0"/>
        <CheckBox x:Name="WinFormsCheck" Content="Движок PrintDocument (WinForms, постранично)" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Печать..." Width="100" Height="28" Margin="0,0,8,0" Click="Print_Click"
                    Background="#FF1E88E5" Foreground="White" BorderThickness="0"/>
            <Button Content="Предпросмотр" Width="110" Height="28" Margin="0,0,8,0" Click="Preview_Click"
                    Background="{DynamicResource InputAreaBackground}" Foreground="{DynamicResource ForegroundColor}"/>
            <Button Content="В XPS..." Width="80" Height="28" Margin="0,0,8,0" Click="SaveXps_Click"
                    Background="{DynamicResource InputAreaBackground}" Foreground="{DynamicResource ForegroundColor}"/>
            <Button Content="Отмена" Width="80" Height="28" Click="Cancel_Click"
                    Background="{DynamicResource InputAreaBackground}" Foreground="{DynamicResource ForegroundColor}"/>
        </StackPanel>
    </StackPanel>
</Window>
