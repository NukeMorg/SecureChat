<Window x:Class="SecureChat.Client.View.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск по сообщениям" Width="560" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundColor}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" Height="28" Padding="6,4" KeyDown="QueryBox_KeyDown"
                     Background="{DynamicResource InputAreaBackground}" Foreground="{DynamicResource ForegroundColor}"
                     BorderBrush="{DynamicResource StatusForeground}"/>
            <Button Grid.Column="1" Content="Найти" Width="90" Height="28" Margin="8,0,0,0" Click="Search_Click"
                    Background="#FF1E88E5" Foreground="White" BorderThickness="0"/>
        </Grid>

        <ListBox x:Name="ResultsList" Grid.Row="1"
                 Background="{DynamicResource ChatAreaBackground}" Foreground="{DynamicResource ForegroundColor}"
                 BorderThickness="0" MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="6,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Source}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding Time}" FontSize="11" Margin="10,0,0,0"
                                           Foreground="{DynamicResource StatusForeground}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="HintTextBlock" Grid.Row="2" Margin="0,6,0,0" FontSize="11"
                   Foreground="{DynamicResource StatusForeground}"
                   Text="Поиск по расшифрованным сообщениям в памяти клиента (загруженные диалоги и каналы). Минимум 3 символа, до 100 результатов. Двойной клик — переход к диалогу."/>
    </Grid>
</Window>
