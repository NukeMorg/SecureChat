<Window x:Class="SecureChat.Client.View.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал аудита" Width="780" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundColor}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Обновить" Width="100" Height="26" Click="Refresh_Click"
                    Background="#FF1E88E5" Foreground="White" BorderThickness="0"/>
            <TextBlock x:Name="CountTextBlock" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource StatusForeground}"/>
        </StackPanel>

        <DataGrid x:Name="AuditGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource ChatAreaBackground}" Foreground="{DynamicResource ForegroundColor}"
                  BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Время (UTC)" Binding="{Binding Timestamp}" Width="190"/>
                <DataGridTextColumn Header="Кто" Binding="{Binding ActorId}" Width="60"/>
                <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="130"/>
                <DataGridTextColumn Header="Кого" Binding="{Binding TargetId}" Width="60"/>
                <DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="130"/>
                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="HintTextBlock" Margin="0,6,0,0" FontSize="11"
                   Foreground="{DynamicResource StatusForeground}"
                   Text="Action/Result — English-константы протокола аудита. Хранится ≥ 90 дней, только INSERT."/>
    </Grid>
</Window>
