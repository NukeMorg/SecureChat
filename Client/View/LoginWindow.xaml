<Window x:Class="SecureChat.Client.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureChat - Корпоративный вход" Height="580" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundColor}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SecureChat Enterprise" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundColor}"/>
            <TextBlock Text="Корпоративный мессенджер с оконечным шифрованием"
                       FontSize="11" Foreground="{DynamicResource StatusForeground}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Панельки режимов -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LoginModePanel" Grid.Column="0" Padding="10,8" Margin="0,0,4,0"
                    CornerRadius="4" Cursor="Hand"
                    Background="{DynamicResource InputAreaBackground}"
                    MouseLeftButtonDown="LoginModePanel_MouseLeftButtonDown">
                <TextBlock x:Name="LoginModeText" Text="Вход" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundColor}"/>
            </Border>

            <Border x:Name="RegisterModePanel" Grid.Column="1" Padding="10,8" Margin="4,0,0,0"
                    CornerRadius="4" Cursor="Hand" Background="Transparent"
                    BorderBrush="{DynamicResource StatusForeground}" BorderThickness="1"
                    MouseLeftButtonDown="RegisterModePanel_MouseLeftButtonDown">
                <TextBlock x:Name="RegisterModeText" Text="Регистрация" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource StatusForeground}"/>
            </Border>
        </Grid>

        <!-- Контент -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <!-- Логин -->
                    <StackPanel x:Name="LoginView">
                        <!-- Email -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Email:" FontSize="12" Margin="0,0,0,4"
                                       Foreground="{DynamicResource ForegroundColor}"/>
                            <Grid>
                                <TextBox x:Name="LoginEmailBox" Height="28" Padding="4"
                                         Background="{DynamicResource InputAreaBackground}"
                                         Foreground="{DynamicResource ForegroundColor}"
                                         BorderBrush="{DynamicResource StatusForeground}"/>
                                <TextBlock Text="example@gmail.com" IsHitTestVisible="False"
                                           Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource StatusForeground}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=LoginEmailBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock x:Name="LoginEmailErrorText" FontSize="10" Margin="0,2,0,0"
                                       Foreground="#FFF44336" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Пароль -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Пароль:" FontSize="12" Margin="0,0,0,4"
                                       Foreground="{DynamicResource ForegroundColor}"/>
                            <PasswordBox x:Name="LoginPasswordBox" Height="28" Padding="4"
                                         Background="{DynamicResource InputAreaBackground}"
                                         Foreground="{DynamicResource ForegroundColor}"
                                         BorderBrush="{DynamicResource StatusForeground}"/>
                            <TextBlock x:Name="LoginPasswordErrorText" FontSize="10" Margin="0,2,0,0"
                                       Foreground="#FFF44336" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Регистрация: шаг 1 — форма -->
                    <StackPanel x:Name="RegisterFormView" Visibility="Collapsed">
                        <!-- Email -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Email:" FontSize="12" Margin="0,0,0,4"
                                       Foreground="{DynamicResource ForegroundColor}"/>
                            <Grid>
                                <TextBox x:Name="RegEmailBox" Height="28" Padding="4"
                                         Background="{DynamicResource InputAreaBackground}"
                                         Foreground="{DynamicResource ForegroundColor}"
                                         BorderBrush="{DynamicResource StatusForeground}"/>
                                <TextBlock Text="example@gmail.com" IsHitTestVisible="False"
                                           Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource StatusForeground}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=RegEmailBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock x:Name="RegEmailErrorText" FontSize="10" Margin="0,2,0,0"
                                       Foreground="#FFF44336" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- ФИО -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="ФИО сотрудника:" FontSize="12" Margin="0,0,0,4"
                                       Foreground="{DynamicResource ForegroundColor}"/>
                            <TextBox x:Name="RegNameBox" Height="28" Padding="4"
                                     Background="{DynamicResource InputAreaBackground}"
                                     Foreground="{DynamicResource ForegroundColor}"
                                     BorderBrush="{DynamicResource StatusForeground}"/>
                        </StackPanel>

                        <!-- Пароль -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Пароль:" FontSize="12" Margin="0,0,0,4"
                                       Foreground="{DynamicResource ForegroundColor}"/>
                            <PasswordBox x:Name="RegPasswordBox" Height="28" Padding="4"
                                         Background="{DynamicResource InputAreaBackground}"
                                         Foreground="{DynamicResource ForegroundColor}"
                                         BorderBrush="{DynamicResource StatusForeground}"/>
                            <ProgressBar x:Name="PasswordStrengthBar" Height="4" Margin="0,6,0,2"
                                         Minimum="0" Maximum="100" Value="0"
                                         Background="#FF2A2A2A" Foreground="#FFF44336"
                                         BorderThickness="0"/>
                            <TextBlock x:Name="PasswordHintText" FontSize="10" Height="14" Margin="0,0,0,0"
                                       Foreground="{DynamicResource StatusForeground}"/>
                            <TextBlock x:Name="RegPasswordErrorText" FontSize="10" Margin="0,2,0,0"
                                       Foreground="#FFF44336" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Регистрация: шаг 2 — код -->
                    <StackPanel x:Name="RegisterCodeView" Visibility="Collapsed">
                        <TextBlock x:Name="CodeInfoText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Foreground="{DynamicResource StatusForeground}"/>

                        <TextBlock Text="Код из письма:" FontSize="12" Margin="0,0,0,4"
                                   Foreground="{DynamicResource ForegroundColor}"/>
                        <TextBox x:Name="CodeBox" Height="32" Padding="6" MaxLength="6"
                                 FontSize="16" FontFamily="Consolas"
                                 HorizontalContentAlignment="Center"
                                 Background="{DynamicResource InputAreaBackground}"
                                 Foreground="{DynamicResource ForegroundColor}"
                                 BorderBrush="{DynamicResource StatusForeground}"/>

                        <Grid Margin="0,8,0,0">
                            <Button x:Name="BackButton" Content="← Назад"
                                    HorizontalAlignment="Left" Padding="8,2"
                                    Background="Transparent" Foreground="#FF1E88E5"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="BackButton_Click"/>
                            <Button x:Name="ResendCodeButton" Content="Отправить код повторно"
                                    HorizontalAlignment="Right" Padding="8,2"
                                    Background="Transparent" Foreground="#FF1E88E5"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="ResendCodeButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Чекбокс «Запомнить меня» (только для входа) -->
                <CheckBox x:Name="RememberMeCheckBox"
                          Content="Запомнить меня"
                          FontSize="12" Margin="0,10,0,0"
                          Foreground="{DynamicResource ForegroundColor}"
                          ToolTip="При следующем запуске приложение войдёт в аккаунт автоматически. Пароль не сохраняется."/>

                <!-- Строка статуса (промежуточные и позитивные сообщения) -->
                <TextBlock x:Name="StatusTextBlock" Text="" Foreground="#FF4CAF50" FontSize="11"
                           TextWrapping="Wrap" Margin="0,10,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="SubmitButton" Grid.Row="3" Content="Войти" Height="34"
                FontSize="13" FontWeight="SemiBold"
                Background="#FF1E88E5" Foreground="White" BorderThickness="0"
                Click="SubmitButton_Click" Cursor="Hand"/>
    </Grid>
</Window>