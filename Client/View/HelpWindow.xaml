<Window x:Class="SecureChat.Client.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SecureChat.Client.Services"
        Title="Руководство пользователя" Height="600" Width="900"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundColor}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TreeView x:Name="HelpTree" Grid.Column="0"
                  Background="Transparent" Foreground="{DynamicResource ForegroundColor}"
                  BorderThickness="0" Margin="5">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Title}" Margin="2"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <StackPanel DataContext="{Binding SelectedItem, ElementName=HelpTree}">
                <Image Source="{Binding ImageSource}"
                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}"
                       Stretch="Uniform" MaxWidth="600" MaxHeight="300"
                       Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource ForegroundColor}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>