<Window x:Class="SecureChat.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SecureChat.Client"
        xmlns:conv="clr-namespace:SecureChat.Client.Services"
        Title="SecureChat Enterprise" Height="650" Width="950"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundColor}"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Command="{x:Static local:MainWindow.ExitCommand}" Gesture="Ctrl+Q"/>
        <KeyBinding Command="{x:Static local:MainWindow.ToggleThemeCommand}" Gesture="Ctrl+T"/>
        <KeyBinding Command="{x:Static local:MainWindow.ChangeNameCommand}" Gesture="Ctrl+N"/>
        <KeyBinding Command="{x:Static local:MainWindow.SearchMessagesCommand}" Gesture="Ctrl+F"/>
    </Window.InputBindings>

    <Window.Resources>
        <conv:BoolToHorizontalAlignmentConverter x:Key="BoolToHorizontalAlignmentConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:FileNameConverter x:Key="FileNameConverter"/>

        <!-- Единый список: шаблон контакта -->
        <DataTemplate x:Key="ContactTemplate">
            <Border Background="{DynamicResource ContactItemBackground}" CornerRadius="6" Margin="2" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Fill" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   Foreground="{DynamicResource StatusForeground}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding UnreadBadge}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                               Foreground="#FF1E88E5"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Единый список: шаблон канала -->
        <DataTemplate x:Key="ChannelTemplate">
            <Border Background="{DynamicResource ContactItemBackground}" CornerRadius="6" Margin="2" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" FontWeight="Bold" FontSize="14" Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource StatusForeground}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                   Foreground="{DynamicResource StatusForeground}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding UnreadBadge}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                               Foreground="#FF1E88E5"/>
                </Grid>
            </Border>
        </DataTemplate>

        <local:ChatItemTemplateSelector ContactTemplate="{StaticResource ContactTemplate}"
                                        ChannelTemplate="{StaticResource ChannelTemplate}"
                                        x:Key="ChatItemSelector"/>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ContactItemBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" FontSize="13" Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource ForegroundColor}">
            <!-- Файл -->
            <MenuItem Header="Файл">
                <MenuItem Header="Сменить учетную запись" Click="SwitchAccount_Click"/>
                <MenuItem Header="Выход" Command="{x:Static local:MainWindow.ExitCommand}" InputGestureText="Ctrl+Q"/>
            </MenuItem>

            <!-- Вид -->
            <MenuItem Header="Вид">
                <MenuItem Header="Поиск по сообщениям..." Command="{x:Static local:MainWindow.SearchMessagesCommand}" InputGestureText="Ctrl+F"/>
                <Separator/>
                <MenuItem Header="Сменить тему" Command="{x:Static local:MainWindow.ToggleThemeCommand}" InputGestureText="Ctrl+T"/>
            </MenuItem>

            <!-- Профиль -->
            <MenuItem Header="Профиль">
                <MenuItem Header="Изменить имя..." Command="{x:Static local:MainWindow.ChangeNameCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Сменить пароль..." Click="ChangePassword_Click"/>
                <MenuItem Header="Изменить статус..." Click="ChangeStatus_Click"/>
                <MenuItem Header="Загрузить аватар..." Click="UploadAvatar_Click"/>
                <Separator/>
                <MenuItem Header="Мой профиль..." Click="ShowMyProfile_Click"/>
                <MenuItem Header="Профиль выбранного пользователя..." Click="ShowSelectedProfile_Click"/>
                <Separator/>
                <MenuItem Header="Показать мой публичный ключ" Click="ShowMyPublicKey_Click"/>
            </MenuItem>

            <!-- Администрирование (видно только роли Admin) -->
            <MenuItem Header="Администрирование" x:Name="AdminMenu" Visibility="Collapsed">
                <MenuItem Header="Заблокировать выбранного..." Click="BanSelectedUser_Click"/>
                <MenuItem Header="Разблокировать выбранного..." Click="UnbanSelectedUser_Click"/>
                <MenuItem Header="Сменить роль выбранного..." Click="ChangeRoleSelectedUser_Click"/>
                <Separator/>
                <MenuItem Header="Журнал аудита..." Click="AuditLog_Click"/>
            </MenuItem>

            <!-- Экспорт (только клиент, расшифрованные данные текущего чата) -->
            <MenuItem Header="Экспорт">
                <MenuItem Header="Текущий чат в Excel..." Click="ExportExcel_Click"/>
            </MenuItem>

            <!-- Каналы (создание и участники — только HR/Admin) -->
            <MenuItem Header="Каналы">
                <MenuItem Header="Создать канал..." x:Name="ChannelCreateMenuItem" Click="CreateChannel_Click" Visibility="Collapsed"/>
                <MenuItem Header="Добавить участника..." x:Name="ChannelAddMemberMenuItem" Click="AddChannelMember_Click" Visibility="Collapsed"/>
                <MenuItem Header="Удалить участника..." x:Name="ChannelRemoveMemberMenuItem" Click="RemoveChannelMember_Click" Visibility="Collapsed"/>
                <Separator/>
                <MenuItem Header="Обновить список" Click="RefreshChannels_Click"/>
            </MenuItem>

            <!-- Справка -->
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="About_Click"/>
                <Separator/>
                <MenuItem Header="Руководство пользователя" Click="HelpGuide_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: индикатор, поле поиска/добавления и единый список (контакты + каналы) -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" CornerRadius="8" Margin="8">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Индикатор и профиль -->
                    <StackPanel Grid.Row="0" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionIndicator" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="UserIdTextBlock" Text="ID: -" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Единое поле поиска по имени и добавления диалога по ID + Enter -->
                    <Grid Grid.Row="1" Margin="5,2,5,8">
                        <TextBox x:Name="SearchAndAddTextBox" Height="28" Padding="6,4"
                                 Background="{DynamicResource InputAreaBackground}" Foreground="{DynamicResource ForegroundColor}"
                                 BorderBrush="{DynamicResource StatusForeground}"
                                 TextChanged="SearchAndAddTextBox_TextChanged"
                                 KeyDown="SearchAndAddTextBox_KeyDown"/>
                        <TextBlock Text="Поиск по имени или ID + Enter..." IsHitTestVisible="False" Margin="8,6,0,0"
                                   Foreground="{DynamicResource StatusForeground}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchAndAddTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Единый список: контакты + каналы (шаблон выбирается по типу элемента) -->
                    <ListBox x:Name="ContactsListBox" Grid.Row="2"
                             Background="Transparent" Foreground="{DynamicResource ForegroundColor}"
                             BorderThickness="0"
                             ItemTemplateSelector="{StaticResource ChatItemSelector}"
                             SelectionChanged="ContactsListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Ответить" Click="ReplyToMessage_Click"/>
                                            <MenuItem Header="Изменить..." Click="EditMessage_Click"/>
                                            <MenuItem Header="Удалить" Click="DeleteMessage_Click"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Правая панель: переписка -->
            <Grid Grid.Column="1" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка поиска по выбранному чату (Ctrl+F) -->
                <Border Grid.Row="0" x:Name="ChatSearchBar" Visibility="Collapsed"
                        Background="{DynamicResource InputAreaBackground}" CornerRadius="8" Padding="6" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatSearchBox" Height="26" Padding="6,3" FontSize="12" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource ForegroundColor}"
                                 VerticalContentAlignment="Center"
                                 TextChanged="ChatSearchBox_TextChanged" KeyDown="ChatSearchBox_KeyDown"/>
                        <TextBlock x:Name="ChatSearchCount" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource StatusForeground}"/>
                        <Button Grid.Column="2" Content="✕" Click="CloseChatSearch_Click" Width="22" Height="22"
                                Background="Transparent" Foreground="{DynamicResource ForegroundColor}" BorderThickness="0"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource ChatAreaBackground}" CornerRadius="8" Padding="8">
                    <Grid>
                        <ListBox x:Name="MessagesListBox"
                                 Background="Transparent" Foreground="{DynamicResource ForegroundColor}"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Ответить" Click="ReplyToMessage_Click"/>
                                            <MenuItem Header="Изменить..." Click="EditMessage_Click"/>
                                            <MenuItem Header="Удалить" Click="DeleteMessage_Click"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="{Binding IsOutgoing, Converter={StaticResource BoolToHorizontalAlignmentConverter}}" Margin="4">
                                    <Border CornerRadius="10" Padding="10,8" MaxWidth="400">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource IncomingMessageColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource OutgoingMessageColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SenderName}" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{DynamicResource StatusForeground}"
                                                       Visibility="{Binding HasSenderName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding ReplyPreview}" FontSize="11" FontStyle="Italic"
                                                       Foreground="{DynamicResource StatusForeground}" TextWrapping="Wrap"
                                                       Visibility="{Binding HasReply, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Text}" Visibility="{Binding TextVisibility}"
                                                       Foreground="{DynamicResource MessageTextForeground}" FontSize="13" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding FileVisibility}">
                                                <TextBlock Text="📎 " Foreground="{DynamicResource MessageTextForeground}"/>
                                                <TextBlock Text="{Binding FilePath, Converter={StaticResource FileNameConverter}}" 
                                                           Foreground="{DynamicResource FilePathForeground}" FontSize="13"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" FontSize="10"
                                                            Foreground="{DynamicResource TimestampForeground}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding EditedMark}" FontSize="9"
                                                           Foreground="{DynamicResource StatusForeground}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                        <Button x:Name="LoadMoreButton" Content="↑ Загрузить ещё" Click="LoadMore_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{DynamicResource InputAreaBackground}" Foreground="{DynamicResource ForegroundColor}"
                                BorderThickness="0" Padding="8,3" FontSize="11" Margin="0,2,4,0" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Панель ответа/редактирования -->
                <Border Grid.Row="2" x:Name="ReplyBar" Visibility="Collapsed"
                        Background="{DynamicResource InputAreaBackground}" CornerRadius="8"
                        Padding="8,5" Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ReplyBarText" TextTrimming="CharacterEllipsis" FontSize="12"
                                   Foreground="{DynamicResource StatusForeground}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Click="CancelReply_Click"
                                Background="Transparent" Foreground="{DynamicResource ForegroundColor}"
                                BorderThickness="0" Width="24" Height="24"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="{DynamicResource InputAreaBackground}" CornerRadius="8" Padding="5" Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="📎" Click="AttachFileButton_Click" 
                                Background="Transparent" Foreground="{DynamicResource ForegroundColor}" BorderThickness="0"
                                Width="35" Height="35" FontSize="16" Margin="5"/>
                        <TextBox x:Name="MessageTextBox" Grid.Column="1"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="Transparent" Foreground="{DynamicResource ForegroundColor}"
                                 BorderThickness="0" Padding="10,8"
                                 VerticalContentAlignment="Center" MaxLines="4"
                                 PreviewKeyDown="MessageTextBox_PreviewKeyDown"/>
                        <Button Grid.Column="2" Content="➤" Click="SendButton_Click"
                                Background="#FF1E88E5" Foreground="White" BorderThickness="0"
                                Width="40" Height="40" FontSize="18" Margin="5"
                                ToolTip="Отправить (Ctrl+Enter)"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>