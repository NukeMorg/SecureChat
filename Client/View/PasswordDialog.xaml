<Window x:Class="SecureChat.Client.View.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundColor}">
    <StackPanel Margin="18">
        <TextBlock Text="Текущий пароль" FontSize="12" Foreground="{DynamicResource StatusForeground}"/>
        <PasswordBox x:Name="CurrentPasswordBox" Height="28" Margin="0,4,0,10" Padding="6,4"
                     Background="{DynamicResource InputAreaBackground}"
                     Foreground="{DynamicResource ForegroundColor}"
                     BorderBrush="{DynamicResource StatusForeground}"/>

        <TextBlock Text="Новый пароль (минимум 8 символов, буква и цифра)" FontSize="12"
                   Foreground="{DynamicResource StatusForeground}"/>
        <PasswordBox x:Name="NewPasswordBox" Height="28" Margin="0,4,0,10" Padding="6,4"
                     Background="{DynamicResource InputAreaBackground}"
                     Foreground="{DynamicResource ForegroundColor}"
                     BorderBrush="{DynamicResource StatusForeground}"/>

        <TextBlock Text="Повторите новый пароль" FontSize="12" Foreground="{DynamicResource StatusForeground}"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Height="28" Margin="0,4,0,14" Padding="6,4"
                     Background="{DynamicResource InputAreaBackground}"
                     Foreground="{DynamicResource ForegroundColor}"
                     BorderBrush="{DynamicResource StatusForeground}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Height="28" Margin="0,0,8,0" Click="Ok_Click"
                    Background="#FF1E88E5" Foreground="White" BorderThickness="0"/>
            <Button Content="Отмена" Width="90" Height="28" Click="Cancel_Click"
                    Background="{DynamicResource InputAreaBackground}"
                    Foreground="{DynamicResource ForegroundColor}"/>
        </StackPanel>
    </StackPanel>
</Window>
